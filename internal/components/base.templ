package components

templ Base(title string, savedCount int) {
    <!DOCTYPE html>
    <html lang="en">
        <head>
            <meta charset="UTF-8"> 
            <meta name="viewport" content="width=device-width, initial-scale=1.0"> 
            <title>{title}</title>
            @Css()
        </head>
        <body>
            <div class="page-shell">
                <h1>{title}</h1>
                { children... }
            </div>
            @Footer(savedCount)
        </body>
    </html>
}